# Copy this file to .env in the repository root before running Docker Compose.
# cp env.compose.example .env

POSTGRES_DB=wiserfiles
POSTGRES_USER=wiserfiles
POSTGRES_PASSWORD=wiserfiles
# DATABASE_URL is assembled in docker-compose.yml from POSTGRES_* values.

# External reverse-proxy network used by nginx-proxy (optional override).
WEB_EXTERNAL_NETWORK=docker_webnet

# Deployment mode for deploy.sh:
# - git: pull origin/main on the server and build locally
# - registry: pull WEB_IMAGE from a container registry and run without build
DEPLOY_MODE=git

# Optional git source controls used by DEPLOY_MODE=git.
DEPLOY_GIT_REMOTE=origin
DEPLOY_GIT_REF=main

# Optional image reference for DEPLOY_MODE=registry.
# Example: ghcr.io/your-org/pdf-saas-web:main
WEB_IMAGE=

# Local release helper input (used by release.sh).
# Example: ghcr.io/your-org/pdf-saas-web
WEB_IMAGE_REPO=

# Optional local ship helper defaults (used by ship.sh).
DEPLOY_SSH_TARGET=
DEPLOY_SSH_PORT=22
DEPLOY_SSH_IDENTITY=
DEPLOY_APP_DIR=/var/www/pdf-saas

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Integration secrets at rest (AES-256-GCM). Use a long random string (>=32 chars).
ENCRYPTION_KEY=your_long_random_encryption_key_here

# GitHub App installation flow (optional). The private key is a single-line PEM
# with literal \n newlines. Never commit these.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=WiserFiles <invites@idealsoftwaresolutions.com>
