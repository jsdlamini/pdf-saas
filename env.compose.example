# Copy this file to .env in the repository root before running Docker Compose.
# cp env.compose.example .env

POSTGRES_DB=wiserfiles
POSTGRES_USER=wiserfiles
POSTGRES_PASSWORD=wiserfiles
DATABASE_URL=postgresql://wiserfiles:wiserfiles@db:5432/wiserfiles

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
